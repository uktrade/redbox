{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Attach to Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/redbox/redbox", "remoteRoot": "/usr/src/app/redbox" },
        { "localRoot": "${workspaceFolder}/django_app", "remoteRoot": "/usr/src/app" }
      ],
      "django": true,
      "justMyCode": true
    }
  ]
}
